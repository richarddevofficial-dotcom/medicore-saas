################################################################################
# MediCore SaaS - Environment Variables Template
# 
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Update values for your environment
#   3. NEVER commit .env to Git!
#   4. This file (.env.example) can be safely committed
#
# For local development, see .env
# For production, see .env.production.example
################################################################################

DEBUG=true
DJANGO_SECRET_KEY=your-secret-key-here
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgresql://postgres:postgres@medicore-postgres:5432/medicore
REDIS_URL=redis://medicore-redis:6379/0

ENCRYPTION_KEY=your-encryption-key-here
BACKUP_ENCRYPTION_KEY=your-backup-key-here

SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@medicore.local
FRONTEND_APP_URL=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

LOG_LEVEL=DEBUG
DEBUG_LOGGING=true

ENABLE_PASSWORD_VALIDATORS=true
ENABLE_OTP_LOGIN=true
ENABLE_TRUSTED_DEVICES=true
ENABLE_ACTIVITY_MONITOR=true
ENABLE_BACKUP_ENCRYPTION=true
