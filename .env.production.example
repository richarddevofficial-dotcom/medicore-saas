################################################################################
# MediCore SaaS - Production Environment Variables
#
# CRITICAL: This is a template only!
# Create actual .env with real values before deploying to production
#
# SECURITY NOTES:
#   1. Generate new DJANGO_SECRET_KEY (don't reuse development key)
#   2. Generate new ENCRYPTION_KEY 
#   3. Use strong SMTP credentials
#   4. Enable all SSL/Security headers
#   5. Store .env in secure location (not in Git!)
#   6. Use AWS Secrets Manager or similar for key rotation
#
# Generation scripts:
#   DJANGO_SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#   ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   BACKUP_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
################################################################################

# PRODUCTION SECURITY SETTINGS
DEBUG=false
DJANGO_SECRET_KEY=<GENERATE-NEW-KEY-PRODUCTION-ONLY>
ENVIRONMENT=production
ALLOWED_HOSTS=api.medicorecloud.com,medicorecloud.com,www.medicorecloud.com

# PRODUCTION DATABASE (Use managed PostgreSQL like Neon)
DATABASE_URL=postgresql://user:password@neon-db-host:5432/medicore_prod

# PRODUCTION CACHE & BROKER (Use managed Redis)
REDIS_URL=redis://redis-host:6379/0

# ENCRYPTION KEYS (Generate new for production!)
ENCRYPTION_KEY=<GENERATE-NEW-KEY-PRODUCTION-ONLY>
BACKUP_ENCRYPTION_KEY=<GENERATE-NEW-KEY-PRODUCTION-ONLY>

# FORCE HTTPS & SECURITY HEADERS
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# PRODUCTION CORS (Whitelist only your domain)
CORS_ALLOWED_ORIGINS=https://medicorecloud.com,https://www.medicorecloud.com
CSRF_TRUSTED_ORIGINS=https://medicorecloud.com,https://www.medicorecloud.com

# PRODUCTION EMAIL (Use SMTP service like Brevo, SendGrid, AWS SES)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=<YOUR-BREVO-API-KEY>
EMAIL_HOST_PASSWORD=<YOUR-BREVO-API-SECRET>
DEFAULT_FROM_EMAIL=noreply@medicorecloud.com
FRONTEND_APP_URL=https://medicorecloud.com
PLATFORM_BASE_DOMAIN=medicorecloud.com
PLATFORM_SUBDOMAIN_MODE=false

# FRONTEND PRODUCTION URL
NEXT_PUBLIC_API_URL=https://api.medicorecloud.com/api/v1
NEXT_PUBLIC_APP_URL=https://medicorecloud.com
NEXT_PUBLIC_DEBUG=false

# AWS S3 FOR BACKUP STORAGE
AWS_ACCESS_KEY_ID=<YOUR-AWS-ACCESS-KEY>
AWS_SECRET_ACCESS_KEY=<YOUR-AWS-SECRET-KEY>
AWS_STORAGE_BUCKET_NAME=medicore-backups-prod
AWS_S3_REGION_NAME=us-east-1

# ERROR TRACKING (Optional: Sentry)
SENTRY_DSN=<YOUR-SENTRY-DSN>

# LOGGING TO FILE/SERVICE
LOG_LEVEL=INFO
DEBUG_LOGGING=false

# FEATURE FLAGS (Keep enabled for production)
ENABLE_PASSWORD_VALIDATORS=true
ENABLE_OTP_LOGIN=true
ENABLE_TRUSTED_DEVICES=true
ENABLE_ACTIVITY_MONITOR=true
ENABLE_BACKUP_ENCRYPTION=true

# SYSTEM ADMIN EMAIL (For critical alerts)
SYSTEM_SUPERADMIN_EMAIL=admin@medicorecloud.com

# PAYMENT GATEWAY (If using Stripe)
STRIPE_PUBLIC_KEY=pk_live_<YOUR-LIVE-PUBLIC-KEY>
STRIPE_SECRET_KEY=sk_live_<YOUR-LIVE-SECRET-KEY>
STRIPE_WEBHOOK_SECRET=<YOUR-WEBHOOK-SECRET>

# TIMEZONE
TIMEZONE=UTC
